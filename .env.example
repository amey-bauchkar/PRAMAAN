# PRAMAAN environment configuration. Copy to .env and fill in; never commit .env.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database / Supabase
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_MANAGEMENT_TOKEN=sbp_...
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Runtime Database Connection (Restricted pramaan_app_user with NOBYPASSRLS)
DATABASE_URL=postgresql://pramaan_app_user.your-project-ref:[RESTRICTED_APP_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Administrative Database Connection (Strictly for migrations / schema updates, never normal API runtime)
DATABASE_URL_ADMIN=postgresql://postgres.your-project-ref:[DBA_ADMIN_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# GitHub OAuth (Optional for sandbox demo, required for live import)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM Gateway (Optional for mock tests, required for live grounded viva)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Bulk Email (Optional, falls back to inert disk transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=


# Web client (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Offline demo (npm run demo sets these for you)
NEXT_PUBLIC_DEMO_MODE=false
# Production code judge (the local runner is for development only)
JUDGE0_URL=
# Skill Passport signing seed: 32 bytes of hex from a secret store
PRAMAAN_ISSUER_SEED=
PRAMAAN_VERIFY_BASE_URL=https://your-domain/verify
# Live LeetCode / Codeforces ownership checks (otherwise demo fixtures)
EXTERNAL_PROFILES_LIVE=false

# Public address of the web app. Invitation links are built from it (https://<this>/claim#t=...).
PRAMAAN_WEB_URL=http://localhost:3000

# Project interview kit: optional read-only GitHub token (a classic or fine-grained token with NO scopes) for GitHub's higher request limit
# when a recruiter has not signed in with GitHub. Public data only.
GITHUB_TOKEN=
# Set to true once GitHub sign-in is switched on in Supabase (apps/web/.env.local).
NEXT_PUBLIC_GITHUB_SIGNIN=false
